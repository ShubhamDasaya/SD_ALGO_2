# ==============================================================================
# ANGEL ONE SMARTAPI CONFIGURATION TEMPLATE
# Copy this file to config.env and fill in your actual credentials
# ==============================================================================

# Angel One SmartAPI Credentials
API_KEY=YOUR_ANGEL_API_KEY
CLIENT_CODE=YOUR_CLIENT_CODE
PIN=YOUR_PIN
PASSWORD=YOUR_PASSWORD
TOTP_SECRET=YOUR_TOTP_SECRET

# Risk & Execution Parameters (Institutional Calibrated)
TRADING_MODE=PAPER_TRADING     # Options: PAPER_TRADING or LIVE_TRADING
MAX_TRADES_PER_DAY=2
MAX_DAILY_LOSS=500             # Hard Circuit Breaker: ₹500 halts the day
MAX_MONTHLY_LOSS=5000          # Monthly Portfolio Armor
TARGET_PROFIT_PER_TRADE=1150   # Target +18 Option Points (~₹1,150 net profit per lot)
STOP_LOSS_POINTS=12            # Stop loss -12 Option Points (~₹780 net loss per lot)
BREAK_EVEN_TRIGGER_POINTS=10   # Move SL to Cost once option moves +10 points
MOMENTUM_TIMEOUT_MINUTES=25    # Exit if no movement within 25 minutes (Theta shield)
INDEX_SYMBOL=NIFTY             # Default trading index (Lot size: 65)
